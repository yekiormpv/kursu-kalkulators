* {
    box-sizing: border-box;
}

body {
    margin: 0 2%;
    font-family: "Century Gothic", sans-serif;
    background: #fff;
    color: #192533;
}

header {
    background: #192533;
    color: #eee;
    font-family: "Comic Sans MS", "Century Gothic", sans-serif;
    padding: 1rem;
    text-align: center;
}

.subtitle {
    font-style: italic;
    color: #fff;
}

table {
    width: 100%;
    margin-top: 20px;
    border-collapse: collapse;
    border: 1px solid #192533;
}

caption, h2 {
    font-size: 1.5rem;
    font-weight: bold;
    text-align: left;
    margin-bottom: 10px;
}

th, td {
    padding: 10px;
    border: 1px solid #192533;
    font-weight: normal;
}

th {
	background: #eee;
}

.td-price {
    text-align: right;  
}

/* Dizains adaptēts telefoniem un citām ierīcem ar šauru ekrānu - tāpēc kalkulatora bloka platība ir = ar body platību */
.calculator {
    margin: 30px auto 15px auto;
    padding: 0px 20px 20px 15px;
    border: 1px solid #19253375;
    border-radius: 12px;
    box-shadow: 5px 10px 10px #00000020;
}

label {
    display: block;
    margin: 20px auto 5px auto;
}

input, select {
	width: 100%;
    padding: 10px;
    border: 1px solid #19253375;
    border-radius: 6px;
    font-size: 1rem;
}

button {
    width: 100%;
    padding: 1em 0.5em;
    margin-top: 25px;
    background: #192533;
    color: #fff;
    border: none;
    border-radius: 6px;
    font-family: "Comic Sans MS", sans-serif;
    font-size: 1.5rem;
    font-weight: bold;
    cursor: pointer;
}

button:hover {
   background: #192533e9;
}

.more {
	background: #446622;
}

.more:hover {
	background: #446622e9;
}

.error {
    color: #660000;
    font-size: 0.9rem;
}

.p-error {
	color: #660000;
	text-align: center;
}

.message {
	margin: 15px auto 15px auto;
    padding: 0px 20px 20px 20px;
    border: 1px solid #19253375;
    border-radius: 12px;
    box-shadow: 5px 10px 10px #00000020;
